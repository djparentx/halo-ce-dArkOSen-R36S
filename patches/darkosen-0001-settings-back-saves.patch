+/* "port profile save and end" (Settings' B and BACK, the profile being
+edited): its changes saved, as OK saves them, then editing ends and the
+previous screen comes back (the PC version's B dropped them; the settings'
+own screens have written theirs as their B was chosen) */
+static boolean profile_save_and_end(struct widget_instance *widget, boolean *widget_deleted)
+{
+	if (player_ui_edit_profile_is_dirty() && !player_ui_save_profile())
+		platform_log("menus: could not save the profile's changes");
+	player_ui_end_editing_profile();
+	ui_play_audio_feedback_sound(SOUND_BACK);
+	ui_widget_port_go_back(widget);
+	*widget_deleted = TRUE;
+	return TRUE;
+}
+
