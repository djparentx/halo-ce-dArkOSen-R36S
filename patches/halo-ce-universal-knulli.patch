diff --git a/port/linux/src/xbox_kernel.c b/port/linux/src/xbox_kernel.c
index 39e1e21c..d9897cf9 100644
--- a/port/linux/src/xbox_kernel.c
+++ b/port/linux/src/xbox_kernel.c
@@ -677,9 +677,65 @@ microsecond counter instead: coarse enough that 32-bit intermediate
 arithmetic in the game stays in range, fine enough for frame timing. */
 #define PLATFORM_PERFORMANCE_FREQUENCY 1000000ULL
 
+static unsigned long long monotonic_microseconds(void)
+{
+	return platform_clock_nanoseconds() / (1000000000ULL / PLATFORM_PERFORMANCE_FREQUENCY);
+}
+
+#if defined(__aarch64__)
+/* On AArch64 the counter is the CPU's generic timer, read directly: the game's
+profile timers (profile.c) read the counter around every texture it sets,
+thousands of times a frame, and in the Android port's guest clock_gettime is
+a call into the host each time. It counts the same microseconds of
+CLOCK_MONOTONIC from an offset taken at start-up. Some Allwinner timers
+return wrong low bits while they roll over: a value whose low nine bits are
+all ones or all zeros is read again (Linux's sun50i workaround). */
+static unsigned long long timer_frequency, timer_offset;
+/* the ticks a microsecond, when that is a whole number (the handhelds' 24 MHz) */
+static unsigned long long timer_divisor;
+
+static unsigned long long timer_ticks(void)
+{
+	unsigned long long ticks;
+
+	do
+		__asm__ volatile("isb\n\tmrs %0, cntvct_el0" : "=r"(ticks) : : "memory");
+	while (((ticks + 1) & 0x1ff) <= 1);
+	return ticks;
+}
+
+static unsigned long long timer_microseconds(unsigned long long ticks)
+{
+	if (timer_divisor)
+		return ticks / timer_divisor;
+	return ticks / timer_frequency * PLATFORM_PERFORMANCE_FREQUENCY +
+		ticks % timer_frequency * PLATFORM_PERFORMANCE_FREQUENCY / timer_frequency;
+}
+
+/* before the game's threads start */
+__attribute__((constructor)) static void timer_initialize(void)
+{
+	unsigned long long frequency;
+
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(frequency));
+	timer_frequency = frequency;
+	if (frequency % PLATFORM_PERFORMANCE_FREQUENCY == 0)
+		timer_divisor = frequency / PLATFORM_PERFORMANCE_FREQUENCY;
+	if (frequency)
+		timer_offset = monotonic_microseconds() - timer_microseconds(timer_ticks());
+}
+#endif
+
 BOOL WINAPI QueryPerformanceCounter(LARGE_INTEGER *count)
 {
-	count->QuadPart = (LONGLONG)(platform_clock_nanoseconds() / (1000000000ULL / PLATFORM_PERFORMANCE_FREQUENCY));
+#if defined(__aarch64__)
+	if (timer_frequency)
+	{
+		count->QuadPart = (LONGLONG)(timer_microseconds(timer_ticks()) + timer_offset);
+		return TRUE;
+	}
+#endif
+	count->QuadPart = (LONGLONG)monotonic_microseconds();
 	return TRUE;
 }
 
