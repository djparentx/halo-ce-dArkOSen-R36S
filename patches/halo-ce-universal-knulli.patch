+/* ---------- buffers mapped once
+
+With GL_EXT_buffer_storage the renderer's streaming buffers are mapped for
+good when they are made (host_gl_buffer_persistent), and a write into one is
+a copy: mapping and unmapping for each write cost Mali's driver about 8 us a
+call, some 450 calls a frame. host_gl_wait_frame still releases a buffer
+only once the GPU is done with the frame that last used it. */
+
+#define PERSISTENT_BUFFERS 8
+
+static struct
+{
+	GLuint buffer;
+	unsigned char *mapping;
+	uint32_t size;
+} persistent_buffers[PERSISTENT_BUFFERS];
+static int persistent_buffer_count;
+
+/* where a thread other than the one making the GL calls may write size
+bytes at offset of a buffer mapped for good, if it is one; the GL calls'
+thread flushes them (host_gl_buffer_flush) */
+unsigned char *host_gl_buffer_mapping(uint32_t buffer, uint32_t offset, uint32_t size)
+{
+	int count = __atomic_load_n(&persistent_buffer_count, __ATOMIC_ACQUIRE), index;
+
+	for (index = 0; index < count; index++)
+	{
+		if (persistent_buffers[index].buffer == buffer)
+			return (uint64_t)offset + size <= persistent_buffers[index].size ? persistent_buffers[index].mapping + offset :
