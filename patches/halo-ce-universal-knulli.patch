+/* each record allocated by itself, so that it stays where it is: a GL call
+can add one (the hook, drawing held instances, translates their shader)
+while another is in use */
+static struct lazy_shader **lazy_shaders;
+static unsigned long lazy_shader_count, lazy_shader_capacity;
+
+static unsigned long long hash_text(const char *text, unsigned long long hash)
+{
+	while (*text)
+		hash = (hash ^ (unsigned char)*text++) * 1099511628211ull;
+	return hash;
+}
+
+/* a shader's record, its layouts placed and what program_build needs of it
+found: on any thread (the shader worker's too) */
+static void lazy_shader_prepare(struct lazy_shader *shader, GLenum type, const char *source, const char *what)
+{
+	memset(shader, 0, sizeof(*shader));
+	shader->type = type;
+	shader->source = xgpu_capabilities.explicit_locations ? explicit_layouts(source, shader) : strdup(source);
+	shader->hash = hash_text(shader->source, 14695981039346656037ull);
+	shader->what = what;
+}
+
+/* the record kept, on the render thread: its handle */
+static GLuint lazy_shader_add(const struct lazy_shader *shader)
+{
+	struct lazy_shader *record = malloc(sizeof(*record));
+
+	if (lazy_shader_count == lazy_shader_capacity)
+	{
+		lazy_shader_capacity = lazy_shader_capacity ? lazy_shader_capacity * 2 : 256;
+		lazy_shaders = realloc(lazy_shaders, lazy_shader_capacity * sizeof(*lazy_shaders));
+	}
+	/* (nothing draws without its shaders) */
+	if (!record || !lazy_shaders)
+	{
+		platform_log("out of memory for a shader");
+		abort();
+	}
+	*record = *shader;
+	lazy_shaders[lazy_shader_count] = record;
+	return LAZY_SHADER | (GLuint)lazy_shader_count++;
+}
+
+static GLuint compile_shader(GLenum type, const char *source, const char *what)
+{
+	struct lazy_shader shader;
+
+	lazy_shader_prepare(&shader, type, source, what);
+	return lazy_shader_add(&shader);
+}
+
+static struct lazy_shader *lazy_shader_get(GLuint handle)
+{
+	unsigned long index = handle & ~LAZY_SHADER;
+
+	return (handle & LAZY_SHADER) && index < lazy_shader_count ? lazy_shaders[index] : NULL;
+}
+
+/* the GL shader for a handle, compiled now if it has not been */
+static GLuint lazy_shader_compile(GLuint handle)
+{
+	struct lazy_shader *shader = lazy_shader_get(handle);
+
+	if (!shader)
+		return handle;
+	if (!shader->shader && !shader->failed)
+	{
+		shader->shader = compile_shader_now(shader->type, shader->source, shader->what);
+		shader->failed = !shader->shader;
+		free(shader->source);
+		shader->source = NULL;
+	}
+	return shader->shader;
+}
+
+/* the text a shader is compiled from: with its layouts placed, or as the
+translator wrote it (debug.gpu_dump_shaders) */
+static const char *shader_text(GLuint shader, const char *source)
+{
+	struct lazy_shader *lazy = lazy_shader_get(shader);
+
+	return lazy && lazy->source ? lazy->source : source;
+}
