+is mapped for good */
+static unsigned char *persistent_mapping(uint32_t target, uint32_t offset, uint32_t size)
+{
+	GLenum binding = buffer_binding(target);
+	GLint buffer = 0;
+
+	if (!binding)
+		return NULL;
+	glGetIntegerv(binding, &buffer);
+	return host_gl_buffer_mapping((uint32_t)buffer, offset, size);
