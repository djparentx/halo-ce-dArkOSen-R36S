+/* ---------- shader programs kept on disk (ES)
+
+Mali compiles and links a program in tens to hundreds of milliseconds: in
+the middle of a frame the first time a combination of shaders is drawn with,
+and again at every start. Linked programs are therefore kept, as the
+driver's binaries, in shaders/ of the save folder, named by a hash of their
+two sources and the driver's version; a program found there is loaded
+without compiling anything. So that it need not be, compile_shader only
+keeps a shader's source, and returns a handle to it: the shaders are
+compiled when a program that uses them is linked. */
+
+#define LAZY_SHADER 0x40000000u
+/* changes to what the port expects of a linked program invalidate the cache */
+#define PROGRAM_CACHE_VERSION 2
+
+/* where the uniforms are when the shaders place them (explicit_layouts),
+and the placed ones' bits in lazy_shader.uses */
+#define LOCATION(name, type, array, location) _location_##name = location,
+#define PLACED(name, type, array, location) _placed_##name,
+enum
+{
+	PLACED_UNIFORMS(LOCATION)
+	_location_high_stride = 4,
+	_location_constants = 64        /* c[], at most XGPU_CONSTANT_BLOCK_MINIMUM */
+};
+enum
+{
+	PLACED_UNIFORMS(PLACED)
+	_placed_count
+};
+#undef LOCATION
+#undef PLACED
+
+/* the declarations the translators write (nv2a_vsh.c, nv2a_psh.c, xgpu.h,
+fragment_instanced_shader), and what each is given: the uniform blocks'
+bindings are those of constants_block_bind, constants_blocks_bind and
+instance_flush */
+#define PLACEMENT(name, type, array, location) \
+	{ "uniform " #type " " #name #array ";", "layout(location = " #location ") uniform " #type " " #name #array ";" },
+static const struct
+{
+	const char *declaration;
+	const char *placed;
+} explicit_placements[] =
+{
+	PLACED_UNIFORMS(PLACEMENT)
+	{ "uniform int xgpu_high_stride;", "layout(location = 4) uniform int xgpu_high_stride;" },
+	{ "\nuniform vec4 c[", "\nlayout(location = 64) uniform vec4 c[" },
+	{ "layout(std140) uniform vertex_constants {", "layout(std140, binding = 0) uniform vertex_constants {" },
+	{ "layout(std140) uniform vertex_constants_low {", "layout(std140, binding = 0) uniform vertex_constants_low {" },
+	{ "layout(std140) uniform vertex_constants_high {", "layout(std140, binding = 1) uniform vertex_constants_high {" },
+	{ "layout(std140) uniform instance_pixel_constants {",
+		"layout(std140, binding = 2) uniform instance_pixel_constants {" },
+	{ "layout(std140) uniform instance_vertex_constants {",
+		"layout(std140, binding = 3) uniform instance_vertex_constants {" },
+};
+#undef PLACEMENT
+
+#define PLACED_NAME(name, type, array, location) USED_NAME(#name),
+static const struct used_name placed_uniforms[_placed_count] = { PLACED_UNIFORMS(PLACED_NAME) };
+#undef PLACED_NAME
+
+struct lazy_shader
+{
+	GLenum type;
+	char *source;
+	unsigned long long hash;
+	GLuint shader;
+	BOOL failed;
+	const char *what;
+	/* what program_build needs of an explicit_layouts source, found once for
+	every program the shader is in: the placed uniforms it uses, and the
+	sizes of its declarations of constants (a vertex shader's c[] and blocks,
+	a pixel shader's instance block) */
+	unsigned long uses;
+	unsigned long constants, constant_block, constant_low, constant_high, instance_constants;
+	BOOL high_stride;
+};
+
+/* the count n of a declaration "<prefix>n]" at, if it is there */
+static unsigned long declared_at(const char *at, const char *prefix, unsigned long length)
+{
+	return strncmp(at, prefix, length) ? 0 : strtoul(at + length, NULL, 10);
+}
+
+#define DECLARED(field, prefix) \
+	if (!shader->field) \
+		shader->field = declared_at(at, prefix, sizeof(prefix) - 1)
+
+/* what program_build needs of a declaration of the shader's (at its
+"uniform ", at the start of a line or not): the first of each */
+static void shader_count(struct lazy_shader *shader, const char *at, BOOL line_start)
+{
+	if (shader->type == GL_VERTEX_SHADER)
+	{
+		/* "\nuniform vec4 c[", placed at location 64 */
+		if (line_start)
+			DECLARED(constants, "uniform vec4 c[");
+		DECLARED(constant_block, "uniform vertex_constants { vec4 c[");
+		DECLARED(constant_low, "uniform vertex_constants_low { vec4 cl[");
+		DECLARED(constant_high, "uniform vertex_constants_high { vec4 ch[");
+		DECLARED(instance_constants, "uniform instance_vertex_constants { vec4 cv[");
+		if (!strncmp(at, "uniform int xgpu_high_stride;", 29))
+			shader->high_stride = TRUE;
+	}
+	else
+		DECLARED(instance_constants, "uniform instance_pixel_constants { vec4 xip[");
+}
+#undef DECLARED
+
+enum { placement_count = sizeof(explicit_placements) / sizeof(explicit_placements[0]) };
+/* where "uniform " is in each declaration, its length and that of its
+placed form: found once, before any shader is translated */
+static unsigned long uniform_at[placement_count], declaration_lengths[placement_count],
+	placed_lengths[placement_count];
+
+static void explicit_layouts_initialize(void)
+{
+	unsigned long index;
+
+	for (index = 0; index < placement_count; index++)
+	{
+		const char *declaration = explicit_placements[index].declaration;
+
+		declaration_lengths[index] = strlen(declaration);
+		placed_lengths[index] = strlen(explicit_placements[index].placed);
+		uniform_at[index] = (unsigned long)(strstr(declaration, "uniform ") - declaration);
+	}
+}
+
+/* source with its uniforms, blocks and samplers placed (the samplers texN at
+binding N): a program needs nothing asked of it once linked (program_build).
+Each declaration holds "uniform ", so one pass over the places it is finds
+where each declaration first is and each sampler, and the sizes program_build
+needs (shader_count); the source is then copied once with them replaced, and
+the placed uniforms it uses noted */
+static char *explicit_layouts(const char *source, struct lazy_shader *shader)
+{
+	/* a sampler texN's placement, at binding N */
+#define SAMPLER_LAYOUT(n) "layout(binding = " #n ") "
+	static const char sampler_layouts[10][sizeof(SAMPLER_LAYOUT(0))] =
+	{
+		SAMPLER_LAYOUT(0), SAMPLER_LAYOUT(1), SAMPLER_LAYOUT(2), SAMPLER_LAYOUT(3), SAMPLER_LAYOUT(4),
+		SAMPLER_LAYOUT(5), SAMPLER_LAYOUT(6), SAMPLER_LAYOUT(7), SAMPLER_LAYOUT(8), SAMPLER_LAYOUT(9)
+	};
+#undef SAMPLER_LAYOUT
+	struct
+	{
+		const char *at;
+		unsigned long skip;
+		const char *placed;
+		unsigned long length;
+	} edits[placement_count + 16];
+	const char *end = source + strlen(source), *cursor, *at;
+	struct xgpu_text text;
+	unsigned long count = 0, index, found = 0;
+	BOOL samplers = TRUE;
+
+	for (at = strstr(source, "uniform "); at && count < sizeof(edits) / sizeof(edits[0]) - 1;
+		at = strstr(at + 8, "uniform "))
+	{
+		for (index = 0; index < placement_count; index++)
+		{
+			const char *start = at - uniform_at[index];
+
+			if (!(found >> index & 1) && (unsigned long)(at - source) >= uniform_at[index] &&
+				!strncmp(start, explicit_placements[index].declaration, declaration_lengths[index]))
+			{
+				found |= 1UL << index;
+				edits[count].at = start;
+				edits[count].skip = declaration_lengths[index];
+				edits[count].placed = explicit_placements[index].placed;
+				edits[count].length = placed_lengths[index];
+				count++;
+				break;
+			}
+		}
+		/* "uniform <sampler type> texN;", up to the first that is not */
+		if (samplers && !strncmp(at + 8, "sampler", 7))
+		{
+			const char *name = strstr(at, " tex");
+
+			if (!name || name[4] < '0' || name[4] > '9' || name[5] != ';')
+				samplers = FALSE;
+			else
+			{
+				edits[count].at = at;
+				edits[count].skip = 0;
+				edits[count].placed = sampler_layouts[name[4] - '0'];
+				edits[count].length = sizeof(sampler_layouts[0]) - 1;
+				count++;
+			}
+		}
+		shader_count(shader, at, at > source && at[-1] == '\n');
+	}
+	/* kept for the session: allocated once, at the size the edits make */
+	text.capacity = (unsigned long)(end - source) + 1;
+	for (index = 0; index < count; index++)
+		text.capacity += edits[index].length - edits[index].skip;
+	text.buffer = malloc(text.capacity);
+	text.length = 0;
+	cursor = source;
+	for (index = 0; index < count; index++)
+	{
+		if (edits[index].at < cursor)
+			continue;
+		xgpu_text_put(&text, cursor, (unsigned long)(edits[index].at - cursor));
+		xgpu_text_put(&text, edits[index].placed, edits[index].length);
+		cursor = edits[index].at + edits[index].skip;
+	}
+	xgpu_text_put(&text, cursor, (unsigned long)(end - cursor));
+	shader->uses = names_used(text.buffer, placed_uniforms, _placed_count);
+	return text.buffer;
+}
