+/* The earlier levels' programs deleted. Kept, every level played since the
+start held its programs: about 100 KB of driver memory each, some 200 a
+level (about 25 MB a level). A level's programs are made in a burst when it
+loads (more than PROGRAM_LOAD_BURST in a pass of the sweep, made or made
+again: a level visited again makes its own again), and hardly any while it
+is played. A program not drawn with since the current level loaded goes once
+that level has run PROGRAM_LEVEL_SECONDS. None the current level drew with
+is deleted: one made again mid-level costs the loader's work and its draws
+skipped (deleting everything unused for 60 s after a load, b30's beach
+battle ran at 9-23 fps as its weapons' and effects' programs came back). At
+each Present (nothing is batched or held then) two buckets are looked
+through, all of them every 512 frames: no frame deletes a level's programs
+at once. The entry stays, marked evicted, and the next draw that asks for it
+makes the program again from the cache's binary (program_use: the loader, a
+few ms). Only the programs the host builds (explicit layouts).
+HALO_PROGRAM_LEVEL_SECONDS sets the delay (tests). */
+#define PROGRAM_LEVEL_SECONDS 60
+#define PROGRAM_LOAD_BURST 100
+/* the passes a load's burst is counted over (a load's programs can come
+over several, about 8.5 s each) */
+#define PROGRAM_LOAD_PASSES 3
+#define PROGRAM_SWEEP_BUCKETS 2
+
+static void programs_sweep(void)
+{
+	static long level_seconds = -1;
+	static time_t first_present;
+	/* programs_made and program_clock at the start of this pass and of the
+	ones before it in the window ([0] this one), whether the window's count
+	is over the burst, and when the current level loaded (none yet: ~0) */
+	static unsigned long bucket, deleted, window_made[PROGRAM_LOAD_PASSES], window_start[PROGRAM_LOAD_PASSES];
+	static unsigned long level_start = ~0UL;
+	static BOOL in_burst;
+	struct program_entry *entry;
+	struct timespec now;
+	int count, pass;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	if (!first_present)
+		first_present = now.tv_sec;
+	program_clock = (unsigned long)(now.tv_sec - first_present);
+	if (!xgpu_capabilities.explicit_locations)
+		return;
+	if (level_seconds < 0)
+	{
+		const char *setting = getenv("HALO_PROGRAM_LEVEL_SECONDS");
+
+		level_seconds = setting && atol(setting) > 0 ? atol(setting) : PROGRAM_LEVEL_SECONDS;
+	}
+	for (count = 0; count < PROGRAM_SWEEP_BUCKETS; count++)
+	{
+		if (level_start != ~0UL && program_clock - level_start >= (unsigned long)level_seconds)
+		{
+			for (entry = program_buckets[bucket]; entry; entry = entry->next)
+			{
+				if (!entry->program || entry->last_used >= level_start)
+					continue;
+				if (gl_state.program == entry->program)
+					gl_state.program = (GLuint)~0u;
+				glDeleteProgram(entry->program);
+				entry->program = 0;
+				entry->evicted = TRUE;
+				deleted++;
+			}
+		}
+		/* (a pass done: what it deleted logged; a level loaded during it) */
+		if (++bucket == PROGRAM_BUCKETS)
+		{
+			bucket = 0;
+			if (deleted)
+				platform_log("programs: %lu of the earlier levels' deleted", deleted);
+			deleted = 0;
+			/* (a load: the window's count first over the burst, dated from
+			its oldest pass's start, the date held while the burst is in it) */
+			if (programs_made - window_made[PROGRAM_LOAD_PASSES - 1] > PROGRAM_LOAD_BURST)
+			{
+				if (!in_burst)
+					level_start = window_start[PROGRAM_LOAD_PASSES - 1];
+				in_burst = TRUE;
+			}
+			else
+			{
+				in_burst = FALSE;
+			}
+			for (pass = PROGRAM_LOAD_PASSES - 1; pass > 0; pass--)
+			{
+				window_made[pass] = window_made[pass - 1];
+				window_start[pass] = window_start[pass - 1];
+			}
+			window_made[0] = programs_made;
+			window_start[0] = program_clock;
+		}
+	}
+}
