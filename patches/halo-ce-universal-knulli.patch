+	{
+		if (built_shaders[index].hash == hash && built_shaders[index].type == type)
+		{
+			*shader = built_shaders[index].shader;
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static GLuint built_shader(GLenum type, const char *source, unsigned long long hash)
+{
+	GLuint shader, found;
+	GLint status = 0;
+	int built;
+
+	pthread_mutex_lock(&built_shader_lock);
+	built = built_shader_find(type, hash, &found);
+	pthread_mutex_unlock(&built_shader_lock);
+	if (built)
+		return found;
+	shader = glCreateShader(type);
+	glShaderSource(shader, 1, &source, NULL);
+	glCompileShader(shader);
+	glGetShaderiv(shader, GL_COMPILE_STATUS, &status);
+	if (!status)
+	{
+		char log[4096];
+
+		glGetShaderInfoLog(shader, sizeof(log), NULL, log);
+		host_logf(HOST_LOG_WARN, "cannot compile a %s shader: %s\n%s", type == GL_VERTEX_SHADER ? "vertex" : "fragment",
+			log, source);
+		glDeleteShader(shader);
+		shader = 0;
+	}
+	pthread_mutex_lock(&built_shader_lock);
+	/* (another compiler's, built meanwhile, is the one kept) */
+	if (built_shader_find(type, hash, &found))
+	{
+		pthread_mutex_unlock(&built_shader_lock);
+		if (shader)
+			glDeleteShader(shader);
+		return found;
+	}
+	if (built_shader_count == built_shader_capacity)
+	{
+		size_t capacity = built_shader_capacity ? built_shader_capacity * 2 : 256;
+		void *grown = realloc(built_shaders, capacity * sizeof(*built_shaders));
+
+		/* (without memory it is not kept: compiled again when next asked for) */
+		if (!grown)
+		{
+			pthread_mutex_unlock(&built_shader_lock);
+			return shader;
+		}
+		built_shaders = grown;
+		built_shader_capacity = capacity;
+	}
+	built_shaders[built_shader_count].hash = hash;
+	built_shaders[built_shader_count].type = type;
+	built_shaders[built_shader_count].shader = shader;
+	built_shader_count++;
+	pthread_mutex_unlock(&built_shader_lock);
+	return shader;
+}
