+/* debug.hitch_log: the frames longer than its milliseconds are logged, with
+what the frame did that a smooth one does not and where its time went: the
+game's own work before its first draw, the drawing up to Present, and the
+wait in the Present before it (for the GL thread and the GPU). Only the ES
+settings turn it on. */
+struct hitch_counts
+{
+	unsigned long programs_here, programs_hosted, textures, texture_bytes, mirror_bytes, ring_waits;
+	unsigned long vertex_shaders, pixel_shaders;
+	double programs_ms, textures_ms, shaders_ms, mirror_ms;
+};
+
+static struct
+{
+	double threshold;
+	/* when the frame before ended (its Present began) and when its Present
+	ended, and when this frame's first draw was prepared */
+	double previous_present, present_end, first_draw;
+	/* this frame's, and since the last summary, with its frames and the
+	frames logged */
+	struct hitch_counts frame, total;
+	unsigned long frames, logged;
+} hitch;
+
+static double hitch_clock(void)
+{
+	struct timespec now;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return (double)now.tv_sec * 1000.0 + (double)now.tv_nsec / 1000000.0;
+}
+
+double xgpu_hitch_start(void)
+{
+	return hitch.threshold > 0.0 ? hitch_clock() : 0.0;
+}
+
+/* the time since a start (xgpu_hitch_start), added to *milliseconds */
+static void hitch_add(double *milliseconds, double start)
+{
+	if (start > 0.0)
+		*milliseconds += hitch_clock() - start;
+}
+
+void xgpu_hitch_texture(unsigned long bytes, double start)
+{
+	if (start > 0.0)
+	{
+		hitch.frame.textures++;
+		hitch.frame.texture_bytes += bytes;
+		hitch_add(&hitch.frame.textures_ms, start);
+	}
+}
+
+/* a shader translated (vertex_shader_get, fragment_shader_get) */
+static void hitch_shader(BOOL vertex, double start)
+{
+	if (start > 0.0)
+	{
+		if (vertex)
+			hitch.frame.vertex_shaders++;
+		else
+			hitch.frame.pixel_shaders++;
+		hitch_add(&hitch.frame.shaders_ms, start);
+	}
+}
+
+/* at the start of Present: the frame that ends here, logged if it was long */
+static void hitch_frame_end(void)
+{
+	const struct hitch_counts *frame = &hitch.frame;
+	struct hitch_counts *total = &hitch.total;
+	double now = hitch_clock();
+
+	if (hitch.previous_present > 0.0 && now - hitch.previous_present > hitch.threshold)
+	{
+		double first = hitch.first_draw > 0.0 ? hitch.first_draw : now, drawing = now - first;
+
+		platform_log("hitch: %.1f ms frame: game %.1f, drawing %.1f, waiting before it %.1f; "
+			"programs %lu made here %lu handed to the host (%.1f ms), textures %lu (%lu KB, %.1f ms), shaders %lu vertex "
+			"%lu pixel (%.1f ms), geometry %lu KB (%.1f ms), ring waits %lu; rest of the drawing %.1f",
+			now - hitch.previous_present, first - hitch.present_end, drawing, hitch.present_end - hitch.previous_present,
+			frame->programs_here, frame->programs_hosted, frame->programs_ms, frame->textures, frame->texture_bytes / 1024,
+			frame->textures_ms, frame->vertex_shaders, frame->pixel_shaders, frame->shaders_ms,
+			frame->mirror_bytes / 1024, frame->mirror_ms, frame->ring_waits,
+			drawing - frame->programs_ms - frame->textures_ms - frame->shaders_ms - frame->mirror_ms);
+		hitch.logged++;
+	}
+	total->programs_here += frame->programs_here;
+	total->programs_hosted += frame->programs_hosted;
+	total->programs_ms += frame->programs_ms;
+	total->textures += frame->textures;
+	total->texture_bytes += frame->texture_bytes;
+	total->textures_ms += frame->textures_ms;
+	total->vertex_shaders += frame->vertex_shaders;
+	total->pixel_shaders += frame->pixel_shaders;
+	total->shaders_ms += frame->shaders_ms;
+	if (++hitch.frames == 600)
+	{
+		platform_log("hitch summary, 600 frames: %lu over %.0f ms; programs %lu made here %lu handed to the host "
+			"(%.0f ms), textures %lu (%lu KB, %.0f ms), shaders %lu (%.0f ms)", hitch.logged, hitch.threshold,
+			total->programs_here, total->programs_hosted, total->programs_ms, total->textures,
+			total->texture_bytes / 1024, total->textures_ms, total->vertex_shaders + total->pixel_shaders,
+			total->shaders_ms);
+		memset(total, 0, sizeof(*total));
+		hitch.frames = hitch.logged = 0;
+	}
+	memset(&hitch.frame, 0, sizeof(hitch.frame));
+	hitch.previous_present = now;
+	hitch.first_draw = 0.0;
+}
