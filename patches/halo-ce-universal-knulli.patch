+gl_InstanceID (XGPU_OUTPUT_INSTANCED), the pixel shader through the index the
+vertex shader passes on (fragment_instanced_shader). Their other uniforms
+must be the same.
+
+prepare_draw binds nothing of a draw that may be held (its program, its
+constants, its uniforms); instance_flush binds the instanced program's. As
+with the quad batch, a GL call draws the held draws first
+(guest_gl_before_call): a draw that joins has made none, so the GL state is
+still theirs. If the draw being prepared had bound its program and constants
+already, they are put back. A draw left by itself is drawn with its own
+program when that is known between draws (the next draw is of other
+geometry): the instanced shaders read the constants from memory, which
+costs the GPU more. debug.instance_models = false draws each by itself. */
+
+/* ps_c0[8], ps_c1[8], ps_final_c0 and ps_final_c1, in that order */
+#define INSTANCE_PIXEL_CONSTANTS 18
+
+static struct
+{
+	BOOL pending;
+	/* the draw's program, and its instanced variant that draws them */
+	struct program_entry *entry, *instanced;
+	/* what the first draw was called with, and prepare_draw chose */
+	const WORD *index_data;
+	D3DPRIMITIVETYPE primitive_type;
+	struct vertex_shader_object *declaration, *program_object;
+	unsigned long outputs;
+	/* the low registers the program reads that differ between the draws */
+	unsigned long long low_mask;
+	GLenum mode;
+	unsigned long minimum, maximum, index_count, index_offset;
+	GLint base_vertex;
+	/* the high registers each draw's nodes fill */
+	unsigned long extent;
+	/* the first draw's other uniforms, the same for all but the pixel constants */
+	struct draw_uniforms uniforms;
+	unsigned long long uniforms_serial;
+	/* the first draw's constant serials, for drawing it by itself */
+	unsigned long long low_version, high_version;
+	unsigned long count;
+	float low[XGPU_INSTANCES][XGPU_CONSTANT_SPLIT][4];
+	/* the draws' high registers, extent registers apart */
+	float high[XGPU_INSTANCE_HIGH_REGISTERS][4];
+	float pixel[XGPU_INSTANCES][INSTANCE_PIXEL_CONSTANTS][4];
+} instances;
+
+/* the pixel shader of an instanced program: its constants read from the
+instance's copy in a uniform block (binding 2), at the instance the vertex
+shader passes on; 0 if the shader does not declare them as expected */
+static GLuint fragment_instanced_shader(struct fragment_entry *fragment)
+{
+	static const char declarations[] = "uniform vec4 ps_c0[8];\nuniform vec4 ps_c1[8];\n"
+		"uniform vec4 ps_final_c0;\nuniform vec4 ps_final_c1;\n";
+	static const char *const names[4][2] =
+	{
+		{ "ps_c0[", "xip[xipb + " }, { "ps_c1[", "xip[xipb + 8 + " },
+		{ "ps_final_c0", "xip[xipb + 16]" }, { "ps_final_c1", "xip[xipb + 17]" }
+	};
+	struct xgpu_text text = { 0 };
+	const char *cursor, *found;
+	char *source;
+
+	if (fragment->instanced_tried)
+		return fragment->instanced_shader;
+	fragment->instanced_tried = TRUE;
+	source = nv2a_pixel_shader_to_glsl(&fragment->key);
+	found = strstr(source, declarations);
+	if (!found)
+	{
+		free(source);
+		return 0;
+	}
+	xgpu_text_put(&text, source, (unsigned long)(found - source));
+	xgpu_text_append(&text, "layout(std140) uniform instance_pixel_constants { vec4 xip[%d]; };\n"
+		"flat in highp int xInstance;\n#define xipb (xInstance * %d)\n", INSTANCE_PIXEL_CONSTANTS * XGPU_INSTANCES,
+		INSTANCE_PIXEL_CONSTANTS);
+	cursor = found + sizeof(declarations) - 1;
+	for (;;)
+	{
+		const char *next = NULL;
+		int which = 0, index;
+
+		for (index = 0; index < 4; index++)
+		{
+			const char *at = strstr(cursor, names[index][0]);
+
+			if (at && (!next || at < next))
+			{
+				next = at;
+				which = index;
+			}
+		}
+		if (!next)
+		{
+			xgpu_text_put(&text, cursor, strlen(cursor));
+			break;
+		}
+		xgpu_text_put(&text, cursor, (unsigned long)(next - cursor));
+		xgpu_text_put(&text, names[which][1], strlen(names[which][1]));
+		cursor = next + strlen(names[which][0]);
+	}
+	free(source);
+	fragment->instanced_shader = compile_shader(GL_FRAGMENT_SHADER, text.buffer, "pixel");
+	free(text.buffer);
+	return fragment->instanced_shader;
+}
+
+/* an instanced variant's program, if it has what drawing instances needs:
+the pixel constants' block, the high stride, and the instances' low
+registers' block when they read any; NULL if not */
+static struct program_entry *instanced_program(GLuint vertex_shader, GLuint fragment_shader, BOOL reads_low)
+{
+	struct program_entry *entry = program_get(vertex_shader, fragment_shader);
+
+	if (entry && (!entry->pixel_block_size || entry->high_stride < 0 ||
+		(reads_low && !entry->instance_vertex_block_size)))
+	{
+		return NULL;
+	}
+	return entry;
+}
+
+/* the instanced variant of the program prepare_draw chose, made the first time */
+static struct program_entry *instance_program(struct program_entry *entry)
+{
+	if (!entry->instanced_tried)
+	{
+		GLuint fragment_shader = fragment_instanced_shader(prepared.fragment);
+
+		entry->instanced_tried = TRUE;
+		if (fragment_shader)
+		{
+			entry->instanced = instanced_program(vertex_shader_get(prepared.program, FALSE,
+				prepared.outputs | XGPU_OUTPUT_INSTANCED, prepared.program->low_reads), fragment_shader,
+				prepared.program->low_reads != 0);
+		}
+	}
+	return entry->instanced;
+}
+
+/* the instanced variant for the low registers that differ between the held
+draws (mask), made the first time, a few for each program; if there is none,
+the one with all of them the instances' own, and mask set to those */
+static struct program_entry *instance_variant(unsigned long long *mask)
+{
+	struct program_entry *entry = instances.entry, *variant = NULL;
+	int index;
+
+	if (*mask == instances.program_object->low_reads)
+		return instances.instanced;
+	for (index = 0; index < entry->instanced_variant_count; index++)
+	{
+		if (entry->instanced_variants[index].mask == *mask)
+		{
+			variant = entry->instanced_variants[index].program;
+			break;
+		}
+	}
+	if (index == entry->instanced_variant_count &&
+		index < (int)(sizeof(entry->instanced_variants) / sizeof(entry->instanced_variants[0])))
+	{
+		/* made for the held draws' declaration */
+		struct vertex_shader_object *declaration = device.vertex_shader;
+
+		device.vertex_shader = instances.declaration;
+		variant = instanced_program(vertex_shader_get(instances.program_object, FALSE,
+			instances.outputs | XGPU_OUTPUT_INSTANCED, *mask), instances.instanced->fragment_shader, *mask != 0);
+		device.vertex_shader = declaration;
+		entry->instanced_variants[index].mask = *mask;
+		entry->instanced_variants[index].program = variant;
+		entry->instanced_variant_count++;
+	}
+	if (!variant)
+	{
+		*mask = instances.program_object->low_reads;
+		return instances.instanced;
+	}
+	return variant;
+}
+
+static void instance_flush(void)
+{
+	struct program_entry *entry;
+	unsigned long alignment = device.uniform_alignment ? device.uniform_alignment : 16;
+	unsigned long low_offset, high_offset, pixel_offset, high_registers, index;
+	unsigned long long mask = instances.low_mask;
+	struct uniform_range ranges[2];
+	GLuint program = gl_state.program, array_buffer = gl_state.array_buffer;
+
+	if (!instances.pending)
+		return;
+	instances.pending = FALSE;
+	__atomic_store_n(&guest_gl_before_call, batch_pending() ? batch_flush_hook : NULL, __ATOMIC_RELAXED);
+	if (instances.count == 1 && !gl_hook_active)
+	{
+		/* by itself, between draws: with its own program */
+		state_program(instances.entry->program);
+		constants_blocks_bind_from((const float (*)[4])instances.low[0], instances.low_version,
+			(const float (*)[4])instances.high, instances.high_version, instances.extent);
+		program_uniforms_apply(instances.entry, &instances.uniforms, instances.uniforms_serial);
+		glDrawRangeElementsBaseVertex(instances.mode, (GLuint)instances.minimum, (GLuint)instances.maximum,
+			(GLsizei)instances.index_count, GL_UNSIGNED_SHORT, (const void *)instances.index_offset,
+			instances.base_vertex);
+		return;
+	}
+	memcpy(ranges, uniform_ranges, sizeof(ranges));
+	entry = instance_variant(&mask);
+	/* (bound here, not through program_get) */
+	if (!program_use(entry))
+		return;
+	state_program(entry->program);
+	program_uniforms_apply(entry, &instances.uniforms, instances.uniforms_serial);
+	if (entry->high_stride_value != (GLint)instances.extent)
+	{
+		entry->high_stride_value = (GLint)instances.extent;
+		glUniform1i(entry->high_stride, (GLint)instances.extent);
+	}
+	/* each block's whole range is bound, and only the instances' part of it
+	written */
+	stream_reserve(entry->constant_block_size + entry->constant_high_block_size + entry->pixel_block_size +
+		entry->instance_vertex_block_size + 4 * alignment);
+	if (mask)
+	{
+		/* each draw's own low registers, in order */
+		static float own[XGPU_INSTANCES * XGPU_CONSTANT_SPLIT][4];
+		unsigned long instance, register_index, slot = 0;
+
+		for (instance = 0; instance < instances.count; instance++)
+		{
+			for (register_index = 0; register_index < XGPU_CONSTANT_SPLIT; register_index++)
+			{
+				if (mask >> register_index & 1)
+					memcpy(own[slot++], instances.low[instance][register_index], sizeof(own[0]));
+			}
+		}
+		device.stream_offset = (device.stream_offset + alignment - 1) / alignment * alignment;
+		uniform_range_bind(3, device.stream_buffer, stream_upload(own, slot * sizeof(own[0])),
+			entry->instance_vertex_block_size);
+		stats.constant_bytes += slot * sizeof(own[0]);
+	}
+	/* the low registers all of them share */
+	device.stream_offset = (device.stream_offset + alignment - 1) / alignment * alignment;
+	low_offset = stream_upload(instances.low[0], sizeof(instances.low[0]));
+	device.stream_offset = (device.stream_offset + alignment - 1) / alignment * alignment;
+	/* through the furthest register the last instance can read (past an
+	instance's nodes, weighted 0, it reads the next one's: see
+	constants_blocks_bind_from) */
+	high_registers = (instances.count - 1) * instances.extent + XGPU_VERTEX_CONSTANT_COUNT - XGPU_CONSTANT_SPLIT;
+	if (high_registers > XGPU_INSTANCE_HIGH_REGISTERS)
+		high_registers = XGPU_INSTANCE_HIGH_REGISTERS;
+	high_offset = stream_upload(instances.high, high_registers * sizeof(instances.high[0]));
+	device.stream_offset = (device.stream_offset + alignment - 1) / alignment * alignment;
+	pixel_offset = stream_upload(instances.pixel, instances.count * sizeof(instances.pixel[0]));
+	stats.constant_bytes += sizeof(instances.low[0]) + high_registers * sizeof(instances.high[0]) +
+		instances.count * sizeof(instances.pixel[0]);
+	uniform_range_bind(0, device.stream_buffer, low_offset, entry->constant_block_size);
+	uniform_range_bind(1, device.stream_buffer, high_offset, entry->constant_high_block_size);
+	uniform_range_bind(2, device.stream_buffer, pixel_offset, entry->pixel_block_size);
+	glDrawElementsInstancedBaseVertex(instances.mode, (GLsizei)instances.index_count, GL_UNSIGNED_SHORT,
+		(const void *)instances.index_offset, (GLsizei)instances.count, instances.base_vertex);
+	stats.instanced_draws++;
+	stats.instances += instances.count;
+	/* the draw being prepared, from within whose call these were drawn: the
+	array buffer its call may read (a glVertexAttribPointer whose bind was
+	made already), and its program and constants if it had bound them */
+	if (gl_hook_active)
+	{
+		state_array_buffer(array_buffer);
+		if (outer_state_set)
+		{
+			if (program != (GLuint)~0u)
+				state_program(program);
+			for (index = 0; index < 2; index++)
+			{
+				if (ranges[index].buffer)
+					uniform_range_bind((GLuint)index, ranges[index].buffer, ranges[index].offset,
+						ranges[index].size);
+			}
+		}
+	}
+}
+
+
+/* whether a draw can be the held draws' again: if not, they are drawn before
+it is prepared */
+static BOOL instance_may_join(D3DPRIMITIVETYPE primitive_type, UINT vertex_count, const WORD *index_data)
+{
+	return instances.index_data == index_data && instances.index_count == vertex_count &&
+		instances.primitive_type == primitive_type && instances.declaration == device.vertex_shader;
+}
+
+/* whether the draw's uniforms but the pixel constants are the held draws' */
+static BOOL instance_uniforms_shared(void)
+{
+	struct draw_uniforms shared = draw_uniforms;
+
+	memcpy(shared.ps_c0, instances.uniforms.ps_c0, sizeof(shared.ps_c0));
+	memcpy(shared.ps_c1, instances.uniforms.ps_c1, sizeof(shared.ps_c1));
+	memcpy(shared.ps_final_c0, instances.uniforms.ps_final_c0, sizeof(shared.ps_final_c0));
+	memcpy(shared.ps_final_c1, instances.uniforms.ps_final_c1, sizeof(shared.ps_final_c1));
+	return !memcmp(&shared, &instances.uniforms, sizeof(shared));
+}
+
+/* holds a prepared draw of a two-block program, joining the held draws when it
+is the same draw; FALSE if the program has no instanced variant */
+static BOOL instance_add(struct program_entry *entry, D3DPRIMITIVETYPE primitive_type, const WORD *index_data,
+	unsigned long minimum, unsigned long maximum, unsigned long index_count, unsigned long index_offset,
+	GLint base_vertex)
+{
+	GLenum mode = primitive_mode(primitive_type);
+	unsigned long extent = constants_high_extent ? constants_high_extent : 1;
+	float (*pixel)[4];
+
+	if (instances.pending && (instances.entry != entry || instances.mode != mode || instances.minimum != minimum ||
+		instances.maximum != maximum || instances.index_count != index_count || instances.index_offset != index_offset ||
+		instances.base_vertex != base_vertex || instances.extent != extent || instances.count == XGPU_INSTANCES ||
+		(instances.count + 1) * extent > XGPU_INSTANCE_HIGH_REGISTERS || !instance_uniforms_shared()))
+	{
+		instance_flush();
+	}
+	if (!instances.pending)
+	{
+		if (!prepared.fragment || !instance_program(entry))
+			return FALSE;
+		instances.entry = entry;
+		instances.instanced = entry->instanced;
+		instances.index_data = index_data;
+		instances.primitive_type = primitive_type;
+		instances.declaration = device.vertex_shader;
+		instances.program_object = prepared.program;
+		instances.outputs = prepared.outputs;
+		instances.low_mask = 0;
+		instances.mode = mode;
+		instances.minimum = minimum;
+		instances.maximum = maximum;
+		instances.index_count = index_count;
+		instances.index_offset = index_offset;
+		instances.base_vertex = base_vertex;
+		instances.extent = extent;
+		memcpy(&instances.uniforms, &draw_uniforms, sizeof(draw_uniforms));
+		instances.uniforms_serial = draw_uniforms_serial;
+		instances.low_version = constants_low_serial;
+		instances.high_version = constants_high_serial;
+		instances.count = 0;
+	}
+	memcpy(instances.low[instances.count], device.constants, sizeof(instances.low[0]));
+	if (instances.count)
+	{
+		/* the registers the program reads in which this draw differs from the first */
+		unsigned long long reads = instances.program_object->low_reads & ~instances.low_mask;
+		unsigned long register_index;
+
+		for (register_index = 0; reads; register_index++, reads >>= 1)
+		{
+			if ((reads & 1) && memcmp(instances.low[instances.count][register_index], instances.low[0][register_index],
+				sizeof(instances.low[0][0])))
+			{
+				instances.low_mask |= 1ULL << register_index;
+			}
+		}
+	}
+	memcpy(instances.high[instances.count * extent], device.constants[XGPU_CONSTANT_SPLIT], extent * sizeof(instances.high[0]));
+	pixel = instances.pixel[instances.count];
+	memcpy(pixel[0], draw_uniforms.ps_c0, sizeof(draw_uniforms.ps_c0));
+	memcpy(pixel[8], draw_uniforms.ps_c1, sizeof(draw_uniforms.ps_c1));
+	memcpy(pixel[16], draw_uniforms.ps_final_c0, sizeof(draw_uniforms.ps_final_c0));
+	memcpy(pixel[17], draw_uniforms.ps_final_c1, sizeof(draw_uniforms.ps_final_c1));
+	instances.count++;
+	instances.pending = TRUE;
+	/* (batch_flush draws held instanced draws first) */
+	__atomic_store_n(&guest_gl_before_call, batch_flush_hook, __ATOMIC_RELAXED);
+	return TRUE;
+}
+
+/* a draw prepared to be held that is drawn by itself: its program, constants
+and uniforms, which prepare_draw left */
+static void instance_unheld(struct program_entry *entry)
+{
+	state_program(entry->program);
+	constants_blocks_bind();
+	program_uniforms_apply(entry, &draw_uniforms, draw_uniforms_serial);
+	outer_state_set = TRUE;
+}
