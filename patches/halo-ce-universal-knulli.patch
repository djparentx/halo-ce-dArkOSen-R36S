diff --git a/port/linux/game/spawn_menu.c b/port/linux/game/spawn_menu.c
new file mode 100644
index 00000000..426617b4
--- /dev/null
+++ b/port/linux/game/spawn_menu.c
@@ -0,0 +1,621 @@
+/*
+SPAWN_MENU.C
+
+The spawn menu (port): vehicles, weapons, equipment and AI characters the
+loaded map has, placed in front of the player. Hold Back and press D-pad
+Down to open it; LB and RB change the page, Up and Down (or the left stick)
+pick, Left and Right pick a character's side, A spawns, B (or Back + Down)
+closes, Start closes and pauses. While it is open the game sees only the
+sticks' sideways moves and the right stick of that controller (nothing of
+the keyboard and mouse, when it is the first): the player steps to the
+side and turns, so that what is spawned can be spread out, but its buttons
+and the left stick's up and down are the menu's; buttons held as it closes
+stay out of the game until they are let go. A map unloading closes it.
+
+It is the game's own: in single player, and for the host of a network game
+(co-op or multiplayer), never for a client in another's game, who plays by
+its host's rules. What it makes is made as the retail cheats make objects
+(cheat_all_weapons: object_placement_data_new, object_new), a character as
+a script's ai_attach_free makes an actor (actor_customize_unit arms the
+unit): so in a network game the host's objects and actors reach the
+clients as any other of the host's do (network_objects.c, network_actors.c),
+and nothing new is sent.
+
+After AlphaRing's Halo CE spawn menu (its mcc/spawn/halo1.cpp): the same
+pages and placement.
+*/
+
+#include "cseries.h"
+#include "ai/actor_definitions.h"
+#include "ai/actors.h"
+#include "ai/ai_script.h"
+#include "cache/cache_files.h"
+#include "cutscene/cinematics.h"
+#include "game/game.h"
+#include "game/players.h"
+#include "interface/interface.h"
+#include "interface/ui_widget.h"
+#include "items/equipment_definitions.h"
+#include "items/weapon_definitions.h"
+#include "objects/objects.h"
+#include "rasterizer/rasterizer.h"
+#include "render/render.h"
+#include "tag_files/tag_files.h"
+#include "tag_files/tag_groups.h"
+#include "text/draw_string.h"
+#include "text/font_group.h"
+#include "units/units.h"
+#include "units/vehicle_definitions.h"
+
+#include "spawn_menu.h"
+
+/* platform.h's */
+void platform_log(const char *format, ...);
+
+#include <ctype.h>
+#include <stdio.h>
+#include <string.h>
+#include <xtl.h>
+
+/* ---------- constants */
+
+enum
+{
+	_spawn_page_vehicles,
+	_spawn_page_weapons,
+	_spawn_page_equipment,
+	_spawn_page_characters,
+	NUMBER_OF_SPAWN_PAGES
+};
+
+/* (draw_string.c's, which no header has) */
+enum
+{
+	_text_justification_left = 0
+};
+
+enum
+{
+	_spawn_side_own,
+	_spawn_side_ally,
+	_spawn_side_enemy,
+	NUMBER_OF_SPAWN_SIDES
+};
+
+enum
+{
+	MAXIMUM_SPAWN_ITEMS = 256,
+	SPAWN_NAME_LENGTH = 40,
+	/* the list's rows shown at once */
+	SPAWN_VISIBLE_ROWS = 10,
+	/* a direction held: a step at once, then one each this many polls after
+	the first wait */
+	SPAWN_REPEAT_FIRST_POLLS = 20,
+	SPAWN_REPEAT_POLLS = 4,
+	/* the result shown for this many frames */
+	SPAWN_STATUS_FRAMES = 180,
+	/* an analog button or trigger counts as pressed past this */
+	SPAWN_ANALOG_PRESSED = 64,
+	SPAWN_STICK_PRESSED = 20000
+};
+
+/* the menu's own bits for what a pad holds: the digital buttons' bits as
+they are (XINPUT_GAMEPAD_DPAD_UP ...), the analog buttons' and triggers'
+above them */
+#define SPAWN_ANALOG_BIT(index) (0x0100u << (index))
+#define SPAWN_A SPAWN_ANALOG_BIT(XINPUT_GAMEPAD_A)
+#define SPAWN_B SPAWN_ANALOG_BIT(XINPUT_GAMEPAD_B)
+#define SPAWN_BLACK SPAWN_ANALOG_BIT(XINPUT_GAMEPAD_BLACK)  /* RB on later pads */
+#define SPAWN_WHITE SPAWN_ANALOG_BIT(XINPUT_GAMEPAD_WHITE)  /* LB on later pads */
+
+/* how far ahead of the player each page's things go, and how high */
+static real const spawn_distances[NUMBER_OF_SPAWN_PAGES] = { 5.0f, 1.5f, 1.5f, 3.0f };
+#define SPAWN_HEIGHT 0.8f
+
+static char const *const spawn_page_names[NUMBER_OF_SPAWN_PAGES] =
+{
+	"VEHICLES", "WEAPONS", "EQUIPMENT", "CHARACTERS"
+};
+static char const *const spawn_side_names[NUMBER_OF_SPAWN_SIDES] = { "THEIR OWN", "ALLY", "ENEMY" };
+
+/* ---------- globals */
+
+struct spawn_item
+{
+	long tag_index;
+	char name[SPAWN_NAME_LENGTH];
+};
+
+/* the local player (controller port) whose menu is open, else NONE */
+static short spawn_owner = NONE;
+/* the first controller's menu closed since the keyboard was last read */
+static boolean spawn_keyboard_closed;
+
+static struct
+{
+	short page;
+	short side;
+	short selection[NUMBER_OF_SPAWN_PAGES];
+	short counts[NUMBER_OF_SPAWN_PAGES];
+	struct spawn_item items[NUMBER_OF_SPAWN_PAGES][MAXIMUM_SPAWN_ITEMS];
+	/* a spawn asked for, made on the game's thread (spawn_menu_update) */
+	boolean request;
+	short request_page;
+	short request_side;
+	struct spawn_item request_item;
+	char status[64];
+	boolean status_failed;
+	long status_frames;
+} spawn_menu;
+
+/* each controller's buttons at its last poll, those kept from the game
+until let go, and its held direction's repeat */
+static struct spawn_pad
+{
+	unsigned long held;
+	unsigned long kept;
+	short direction;
+	short direction_polls;
+} spawn_pads[MAXIMUM_LOCAL_PLAYERS];
+
+/* ---------- private code */
+
+/* the player's unit, if the menu is the game's (single player, or the
+host's) and its player has a living one; local players are the gamepads'
+ports (player_control.c) */
+static long spawn_menu_player_unit(
+	short local_player)
+{
+	short connection = game_connection();
+	long player_index, unit_index;
+	struct unit_datum *unit;
+
+	if (connection != _game_connection_local && connection != _game_connection_network_server)
+		return NONE;
+	if (local_player < 0 || local_player >= MAXIMUM_LOCAL_PLAYERS || !game_in_progress() || main_menu_is_active() ||
+		cinematic_in_progress() || ui_widgets_active_for_local_player(local_player))
+	{
+		return NONE;
+	}
+	player_index = local_player_get_player_index(local_player);
+	if (player_index == NONE)
+		return NONE;
+	unit_index = player_get(player_index)->unit_index;
+	unit = unit_index == NONE ? NULL : unit_try_and_get(unit_index);
+	return unit && !TEST_FLAG(unit->object.damage_flags, _object_dead_bit) ? unit_index : NONE;
+}
+
+/* "vehicles\warthog\mp_warthog" -> "MP Warthog": the path's last part in
+words, a short word with no vowel in capitals */
+static void spawn_display_name(
+	char const *path,
+	char *name,
+	size_t size)
+{
+	char const *last = tag_name_strip_path(path);
+	size_t length = 0, word = 0, index;
+
+	for (; *last && length + 1 < size; last++)
+		name[length++] = *last == '_' ? ' ' : *last;
+	name[length] = 0;
+	for (index = 0; index <= length; index++)
+	{
+		if (name[index] != ' ' && name[index] != 0)
+			continue;
+		if (index > word)
+		{
+			size_t letter;
+			boolean vowel = FALSE;
+
+			for (letter = word; letter < index; letter++)
+				vowel |= strchr("aeiouyAEIOUY", name[letter]) != NULL;
+			for (letter = word; letter < index; letter++)
+			{
+				name[letter] = (char)(letter == word || (!vowel && index - word <= 3) ?
+					toupper((unsigned char)name[letter]) : name[letter]);
+			}
+		}
+		word = index + 1;
+	}
+}
+
+/* weapons nobody carries: a vehicle's or a turret's, or one built into a
+character */
+static boolean spawn_weapon_listed(
+	char const *path)
+{
+	return strncmp(path, "vehicles\\", 9) && strncmp(path, "characters\\", 11) && !strstr(path, "\\turret") &&
+		!strstr(path, "integrated");
+}
+
+/* an actor variant with a unit to put it in, and not a swarm's (which
+ai_attach_free refuses) */
+static boolean spawn_character_listed(
+	long tag_index)
+{
+	struct actor_variant_definition const *variant = actor_variant_definition_get(tag_index);
+	long actor_index = variant->actor_reference.index;
+
+	return variant->unit_reference.index != NONE && actor_index != NONE &&
+		!TEST_FLAG(actor_definition_get(actor_index)->flags, _actor_definition_swarm_actor_bit);
+}
+
+/* what the loaded map can spawn, each page sorted by name */
+static void spawn_catalog_build(
+	void)
+{
+	static long const groups[NUMBER_OF_SPAWN_PAGES] =
+	{
+		VEHICLE_DEFINITION_TAG, WEAPON_DEFINITION_TAG, EQUIPMENT_DEFINITION_TAG, ACTOR_VARIANT_DEFINITION_TAG
+	};
+	short page;
+
+	for (page = 0; page < NUMBER_OF_SPAWN_PAGES; page++)
+	{
+		struct spawn_item *items = spawn_menu.items[page];
+		struct tag_iterator iterator;
+		long tag_index;
+		short count = 0, index;
+
+		tag_iterator_new(&iterator, groups[page]);
+		while ((tag_index = tag_iterator_next(&iterator)) != NONE && count < MAXIMUM_SPAWN_ITEMS)
+		{
+			char const *path = tag_get_name(tag_index);
+
+			if (!path)
+				continue;
+			/* (a cutscene's props, not vehicles: b30's falling box) */
+			if (page == _spawn_page_vehicles && !strncmp(path, "cinematics\\", 11))
+				continue;
+			if (page == _spawn_page_weapons && !spawn_weapon_listed(path))
+				continue;
+			if (page == _spawn_page_characters && !spawn_character_listed(tag_index))
+				continue;
+			items[count].tag_index = tag_index;
+			spawn_display_name(path, items[count].name, sizeof(items[count].name));
+			for (index = count; index > 0 && csstrcasecmp(items[index - 1].name, items[index].name) > 0; index--)
+			{
+				struct spawn_item swap = items[index - 1];
+
+				items[index - 1] = items[index];
+				items[index] = swap;
+			}
+			count++;
+		}
+		spawn_menu.counts[page] = count;
+	}
+}
+
+/* a thing of definition_index in front of unit_index, on owner_team (NONE:
+its own); the new object, else NONE */
+static long spawn_object(
+	long definition_index,
+	long unit_index,
+	short page,
+	short owner_team)
+{
+	struct object_placement_data data;
+	real_point3d origin;
+	real_vector3d facing = unit_get(unit_index)->unit.desired_aiming_vector;
+
+	/* (ahead along the ground, where the player looks) */
+	facing.k = 0.0f;
+	if (normalize3d(&facing) < 0.001f)
+		facing = *global_forward3d;
+	object_get_origin(unit_index, &origin);
+	object_placement_data_new(&data, definition_index, NONE);
+	point_from_line3d(&origin, &facing, spawn_distances[page], &data.position);
+	data.position.z += SPAWN_HEIGHT;
+	data.forward = facing;
+	if (owner_team != NONE)
+		data.owner_team_index = owner_team;
+	return object_new(&data);
+}
+
+static void spawn_request_make(
+	void)
+{
+	long unit_index = spawn_menu_player_unit(spawn_owner);
+	short page = spawn_menu.request_page;
+	struct spawn_item const *item = &spawn_menu.request_item;
+	long object_index;
+	boolean failed;
+
+	spawn_menu.request = FALSE;
+	if (unit_index == NONE)
+		return;
+	if (page != _spawn_page_characters)
+	{
+		object_index = spawn_object(item->tag_index, unit_index, page, NONE);
+	}
+	else
+	{
+		long unit_definition_index = actor_variant_definition_get(item->tag_index)->unit_reference.index;
+		short player_team = unit_get(unit_index)->object.owner_team_index;
+		short team = NONE;
+
+		/* an ally on the player's own side (the human team is an ally only
+		where a level's script makes it one); an enemy on the other */
+		if (spawn_menu.request_side == _spawn_side_ally)
+			team = player_team;
+		else if (spawn_menu.request_side == _spawn_side_enemy)
+			team = player_team == _game_team_covenant ? _game_team_human : _game_team_covenant;
+		object_index = spawn_object(unit_definition_index, unit_index, page, team);
+		if (object_index != NONE)
+		{
+			struct unit_datum *spawned;
+
+			actor_customize_unit(item->tag_index, object_index);
+			ai_scripting_attach_free(object_index, item->tag_index);
+			/* (no actor, as when the actors are all in use: no armed statue
+			left standing, as actor_place deletes its unit then) */
+			spawned = unit_try_and_get(object_index);
+			if (!spawned || spawned->unit.actor_index == NONE)
+			{
+				if (spawned)
+					object_delete(object_index);
+				object_index = NONE;
+			}
+		}
+	}
+	failed = object_index == NONE;
+	snprintf(spawn_menu.status, sizeof(spawn_menu.status), "%s %s", failed ? "Couldn't spawn" : "Spawned", item->name);
+	spawn_menu.status_failed = failed;
+	spawn_menu.status_frames = SPAWN_STATUS_FRAMES;
+	platform_log("spawn menu: %s %s (%s)", failed ? "couldn't spawn" : "spawned", item->name,
+		tag_get_name(item->tag_index));
+}
+
+static void spawn_menu_close(
+	void)
+{
+	/* (what is held stays out of the game until let go) */
+	spawn_pads[spawn_owner].kept = spawn_pads[spawn_owner].held;
+	spawn_keyboard_closed |= spawn_owner == 0;
+	spawn_owner = NONE;
+	spawn_menu.request = FALSE;
+}
+
+static void spawn_menu_open(
+	short port)
+{
+	csmemset(spawn_menu.selection, 0, sizeof(spawn_menu.selection));
+	spawn_owner = port;
+	spawn_menu.status_frames = 0;
+	spawn_catalog_build();
+}
+
+/* -1 up, 1 down, or 0; then a step at once and repeated while held */
+static short spawn_vertical_step(
+	struct spawn_pad *state,
+	XINPUT_GAMEPAD const *pad)
+{
+	short direction = (pad->wButtons & XINPUT_GAMEPAD_DPAD_UP) || pad->sThumbLY > SPAWN_STICK_PRESSED ? -1 :
+		(pad->wButtons & XINPUT_GAMEPAD_DPAD_DOWN) || pad->sThumbLY < -SPAWN_STICK_PRESSED ? 1 : 0;
+
+	if (direction != state->direction)
+	{
+		state->direction = direction;
+		state->direction_polls = 0;
+		return direction;
+	}
+	if (!direction)
+		return 0;
+	state->direction_polls++;
+	if (state->direction_polls >= SPAWN_REPEAT_FIRST_POLLS &&
+		(state->direction_polls - SPAWN_REPEAT_FIRST_POLLS) % SPAWN_REPEAT_POLLS == 0)
+	{
+		return direction;
+	}
+	return 0;
+}
+
+static void spawn_pad_clear(
+	XINPUT_GAMEPAD *pad,
+	unsigned long bits)
+{
+	short index;
+
+	pad->wButtons &= (unsigned short)~(bits & 0xFF);
+	for (index = 0; index < 8; index++)
+	{
+		if (bits & SPAWN_ANALOG_BIT(index))
+			pad->bAnalogButtons[index] = 0;
+	}
+}
+
+/* ---------- public code */
+
+void spawn_menu_pad(
+	short port,
+	XINPUT_GAMEPAD *pad)
+{
+	struct spawn_pad *state;
+	unsigned long held = pad->wButtons & 0xFF, pressed;
+	boolean combo;
+	short index;
+
+	if (port < 0 || port >= MAXIMUM_LOCAL_PLAYERS)
+		return;
+	state = &spawn_pads[port];
+	for (index = 0; index < 8; index++)
+	{
+		if (pad->bAnalogButtons[index] > SPAWN_ANALOG_PRESSED)
+			held |= SPAWN_ANALOG_BIT(index);
+	}
+	pressed = held & ~state->held;
+	state->held = held;
+	combo = (held & XINPUT_GAMEPAD_BACK) && (pressed & XINPUT_GAMEPAD_DPAD_DOWN);
+
+	/* (not with Start pressed too: that pauses) */
+	if (spawn_owner == NONE && combo && !(pressed & XINPUT_GAMEPAD_START) && spawn_menu_player_unit(port) != NONE)
+	{
+		spawn_menu_open(port);
+		state->direction = 1;
+		state->direction_polls = 0;
+		csmemset(pad, 0, sizeof(*pad));
+		return;
+	}
+	if (spawn_owner != port)
+	{
+		state->kept &= held;
+		spawn_pad_clear(pad, state->kept);
+		return;
+	}
+
+	/* (a game left, the player dead, a cinematic or a menu begun: closed;
+	Start closes it and pauses, as it would have) */
+	if (combo || (pressed & (SPAWN_B | XINPUT_GAMEPAD_START)) || spawn_menu_player_unit(port) == NONE)
+	{
+		spawn_menu_close();
+		state->kept &= ~(unsigned long)XINPUT_GAMEPAD_START;
+		csmemset(pad, 0, sizeof(*pad));
+		pad->wButtons = (unsigned short)(held & XINPUT_GAMEPAD_START);
+		return;
+	}
+	if (pressed & SPAWN_WHITE)
+		spawn_menu.page = (short)((spawn_menu.page + NUMBER_OF_SPAWN_PAGES - 1) % NUMBER_OF_SPAWN_PAGES);
+	if (pressed & SPAWN_BLACK)
+		spawn_menu.page = (short)((spawn_menu.page + 1) % NUMBER_OF_SPAWN_PAGES);
+	{
+		short page = spawn_menu.page, count = spawn_menu.counts[page];
+		short step = spawn_vertical_step(state, pad);
+
+		if (count && step)
+			spawn_menu.selection[page] = (short)((spawn_menu.selection[page] + step + count) % count);
+		if (page == _spawn_page_characters && (pressed & (XINPUT_GAMEPAD_DPAD_LEFT | XINPUT_GAMEPAD_DPAD_RIGHT)))
+		{
+			spawn_menu.side = (short)((spawn_menu.side +
+				((pressed & XINPUT_GAMEPAD_DPAD_LEFT) ? NUMBER_OF_SPAWN_SIDES - 1 : 1)) % NUMBER_OF_SPAWN_SIDES);
+		}
+		if ((pressed & SPAWN_A) && count && !spawn_menu.request)
+		{
+			spawn_menu.request = TRUE;
+			spawn_menu.request_page = page;
+			spawn_menu.request_item = spawn_menu.items[page][spawn_menu.selection[page]];
+			spawn_menu.request_side = spawn_menu.side;
+		}
+	}
+	{
+		/* (the player steps to the side and turns: the left stick's up and
+		down are the menu's) */
+		SHORT strafe = pad->sThumbLX, look_x = pad->sThumbRX, look_y = pad->sThumbRY;
+
+		csmemset(pad, 0, sizeof(*pad));
+		pad->sThumbLX = strafe;
+		pad->sThumbRX = look_x;
+		pad->sThumbRY = look_y;
+	}
+}
+
+void spawn_menu_update(
+	void)
+{
+	if (spawn_menu.request)
+		spawn_request_make();
+}
+
+int spawn_menu_has(
+	short port)
+{
+	return spawn_owner != NONE && spawn_owner == port;
+}
+
+unsigned long spawn_menu_keyboard_actions(
+	unsigned long held)
+{
+	/* (those held while it was open, or as it closed: read after the poll
+	that closed it, so a key first pressed there too) */
+	static unsigned long kept;
+
+	kept = spawn_owner == 0 || spawn_keyboard_closed ? held : kept & held;
+	spawn_keyboard_closed = FALSE;
+	return held & ~kept;
+}
+
+void spawn_menu_dispose_from_old_map(
+	void)
+{
+	if (spawn_owner != NONE)
+		spawn_menu_close();
+}
+
+/* a line of text in the rows' left column (rasterizer_draw_string gives it
+a drop shadow) */
+static void spawn_menu_line(
+	rectangle2d const *area,
+	long font_index,
+	short line_height,
+	short row,
+	real_argb_color const *color,
+	char const *text)
+{
+	rectangle2d bounds = *area;
+
+	bounds.y0 = (short)(area->y0 + row * line_height);
+	bounds.y1 = (short)(bounds.y0 + line_height);
+	draw_string_set_draw_mode(font_index, NONE, _text_justification_left, 0, color);
+	rasterizer_draw_string(&bounds, NULL, NULL, 0, text);
+}
+
+void spawn_menu_draw(
+	void)
+{
+	long font_index = interface_get_tag_index(_interface_font_terminal);
+	struct font_header *font;
+	short line_height, page = spawn_menu.page, count = spawn_menu.counts[page];
+	short first, row, index;
+	rectangle2d area;
+	char line[96];
+
+	if (spawn_menu.status_frames > 0)
+		spawn_menu.status_frames--;
+	if (spawn_owner == NONE || font_index == NONE)
+		return;
+	font = font_definition_get(font_index);
+	line_height = (short)(font->ascending_height + font->descending_height + font->leading_height);
+	if (line_height <= 0)
+		return;
+	area = render.camera.window_bounds;
+	offset_rectangle2d(&area, -render.camera.viewport_bounds.x0, -render.camera.viewport_bounds.y0);
+	area.x0 = (short)(area.x0 + 24);
+	area.y0 = (short)(area.y0 + 48);
+
+	snprintf(line, sizeof(line), "SPAWN   < %s >   LB / RB", spawn_page_names[page]);
+	spawn_menu_line(&area, font_index, line_height, 0, global_real_argb_yellow, line);
+	row = 2;
+	if (!count)
+	{
+		spawn_menu_line(&area, font_index, line_height, row, global_real_argb_grey, "(none in this map)");
+	}
+	else
+	{
+		first = (short)MAX(0, MIN(spawn_menu.selection[page] - SPAWN_VISIBLE_ROWS / 2, count - SPAWN_VISIBLE_ROWS));
+		for (index = first; index < count && index < first + SPAWN_VISIBLE_ROWS; index++)
+		{
+			boolean selected = index == spawn_menu.selection[page];
+
+			snprintf(line, sizeof(line), "%s %s", selected ? ">" : " ", spawn_menu.items[page][index].name);
+			spawn_menu_line(&area, font_index, line_height, (short)(row + index - first),
+				selected ? global_real_argb_yellow : global_real_argb_white, line);
+		}
+		if (count > SPAWN_VISIBLE_ROWS)
+		{
+			snprintf(line, sizeof(line), "  %d of %d", spawn_menu.selection[page] + 1, count);
+			spawn_menu_line(&area, font_index, line_height, (short)(row + SPAWN_VISIBLE_ROWS), global_real_argb_grey,
+				line);
+		}
+	}
+	row = (short)(row + SPAWN_VISIBLE_ROWS + 2);
+	if (page == _spawn_page_characters)
+	{
+		snprintf(line, sizeof(line), "SIDE   < %s >   LEFT / RIGHT", spawn_side_names[spawn_menu.side]);
+		spawn_menu_line(&area, font_index, line_height, row++, global_real_argb_white, line);
+	}
+	spawn_menu_line(&area, font_index, line_height, row++, global_real_argb_grey, "A SPAWN    B CLOSE");
+	if (spawn_menu.status_frames > 0)
+	{
+		spawn_menu_line(&area, font_index, line_height, row, spawn_menu.status_failed ? global_real_argb_red :
+			global_real_argb_green, spawn_menu.status);
+	}
+}
diff --git a/port/linux/game/spawn_menu.h b/port/linux/game/spawn_menu.h
new file mode 100644
index 00000000..94c92b4b
--- /dev/null
+++ b/port/linux/game/spawn_menu.h
@@ -0,0 +1,27 @@
+#ifndef __SPAWN_MENU_H
+#define __SPAWN_MENU_H
+
+/* port: the spawn menu (spawn_menu.c) */
+
+struct _XINPUT_GAMEPAD;
+
+/* each poll of a controller (port 0-3): opens the menu on Back + D-pad
+Down, drives it while open; the game sees nothing of a pad the menu has,
+nor of buttons held as it closed until they are let go */
+void spawn_menu_pad(short port, struct _XINPUT_GAMEPAD *pad);
+/* each frame on the game's thread (beside cheats_update): the spawn asked
+for */
+void spawn_menu_update(void);
+/* each frame's fullscreen overlays (interface_draw_fullscreen_overlays) */
+void spawn_menu_draw(void);
+/* whether the menu is open on the controller (port 0-3): the mouse, which
+plays as the first, stays out of the game while it is */
+int spawn_menu_has(short port);
+/* the keyboard's actions (it plays as the first controller) the game may
+see: none while the menu has the first controller, and those held as it
+closes not until they are let go */
+unsigned long spawn_menu_keyboard_actions(unsigned long held);
+/* game_dispose_from_old_map: closed, before its list's tags are gone */
+void spawn_menu_dispose_from_old_map(void);
+
+#endif
diff --git a/port/linux/include/halo_linux_source_fixups.h b/port/linux/include/halo_linux_source_fixups.h
index feb6789b..faf0693b 100644
