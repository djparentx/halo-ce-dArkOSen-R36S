+static const char *program_cache_folder(void)
+{
+	static char folder[512];
+	static int made;
+
+	if (!made)
+	{
+		made = 1;
+		if (!config_boolean("debug.no_program_cache"))
+		{
+			snprintf(folder, sizeof(folder), "%s/shaders", platform_save_root());
+			posix_make_directory(folder);
+		}
+	}
+	return folder;
