+
+/* where the cache keeps a program's binary, or "" with no cache */
+static void program_cache_path(unsigned long long key, char *path, size_t size)
+{
+	const char *folder = program_cache_folder();
+
+	*path = 0;
+	if (*folder && key)
+		snprintf(path, size, "%s/%016llx.bin", folder, key);
+}
+
+static unsigned long long program_key(GLuint vertex_shader, GLuint fragment_shader)
+{
+	static unsigned long long driver;
+	struct lazy_shader *vertex = lazy_shader_get(vertex_shader);
+	struct lazy_shader *fragment = lazy_shader_get(fragment_shader);
+	unsigned long long key;
+
+	if (!driver)
+	{
+		driver = hash_text((const char *)glGetString(GL_VERSION), 14695981039346656037ull);
+		driver = hash_text((const char *)glGetString(GL_RENDERER), driver) + PROGRAM_CACHE_VERSION;
+	}
+	if (!vertex || !fragment)
+		return 0;
+	key = (driver ^ vertex->hash) * 1099511628211ull;
+	return (key ^ fragment->hash) * 1099511628211ull;
+}
+
+/* a program from the cache, or 0 */
+static GLuint program_cache_load(unsigned long long key)
+{
+	char path[600];
+	FILE *file;
+	unsigned int header[2];
+	void *binary;
+	GLuint program = 0;
+	GLint status = 0;
+
+	program_cache_path(key, path, sizeof(path));
+	if (!*path || !(file = fopen(path, "rb")))
 		return 0;
+	if (fread(header, sizeof(header), 1, file) == 1 && header[1] && header[1] < 16u * 1024 * 1024 &&
+		(binary = malloc(header[1])) != NULL)
+	{
+		if (fread(binary, header[1], 1, file) == 1)
+		{
+			program = glCreateProgram();
+			glProgramBinary(program, (GLenum)header[0], binary, (GLsizei)header[1]);
+			glGetProgramiv(program, GL_LINK_STATUS, &status);
+			if (!status)
+			{
+				glDeleteProgram(program);
+				program = 0;
+			}
+		}
+		free(binary);
 	}
+	fclose(file);
+	if (!program)
+		remove(path);
 	return program;
 }
 
+static void program_cache_store(unsigned long long key, GLuint program)
+{
+	char path[600], temporary[620];
+	GLint length = 0;
+	GLsizei written = 0;
+	GLenum format = 0;
+	void *binary;
+	FILE *file;
+
+	program_cache_path(key, path, sizeof(path));
+	if (!*path)
+		return;
+	glGetProgramiv(program, GL_PROGRAM_BINARY_LENGTH, &length);
+	if (length <= 0 || !(binary = malloc((size_t)length)))
+		return;
+	glGetProgramBinary(program, length, &written, &format, binary);
+	snprintf(temporary, sizeof(temporary), "%s.part", path);
+	if (written > 0 && (file = fopen(temporary, "wb")) != NULL)
+	{
+		unsigned int header[2] = { (unsigned int)format, (unsigned int)written };
+		BOOL complete = fwrite(header, sizeof(header), 1, file) == 1 && fwrite(binary, (size_t)written, 1, file) == 1;
+
+		if (fclose(file) == 0 && complete)
+			rename(temporary, path);
+		else
+			remove(temporary);
+	}
+	free(binary);
+}
