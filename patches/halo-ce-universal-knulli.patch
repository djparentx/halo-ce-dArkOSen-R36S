+#define PLACED_UNIFORMS(X) \
+	X(viewport_scale, vec4, , 0) \
+	X(viewport_offset, vec4, , 1) \
+	X(point_size, float, , 2) \
+	X(screen_offset, float, , 3) \
+	X(texture_lod_bias, highp vec4, , 5) \
+	X(fog_color, vec4, , 6) \
+	X(fog_parameters, highp vec4, , 7) \
+	X(alpha_reference, float, , 8) \
+	X(ps_final_c0, vec4, , 9) \
+	X(ps_final_c1, vec4, , 10) \
+	X(ps_c0, vec4, [8], 16) \
+	X(ps_c1, vec4, [8], 24) \
+	X(bump_matrix, highp vec4, [4], 32) \
